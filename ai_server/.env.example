# Backend only. Never copy this file into Flutter assets.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
# Generate these with: python setup_assistant.py
ASSISTANT_SIGNING_SECRET=
ASSISTANT_PAIRING_CODE=
ASSISTANT_DAILY_USD=1.00
ASSISTANT_DEVICE_DAILY_USD=0.50
ASSISTANT_RPM=6
# Only for explicitly enabled local debug, never public HTTP.
ASSISTANT_ALLOW_INSECURE_LAN=0
