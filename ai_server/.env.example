# Backend only. Never copy this file into Flutter assets.
# Custom trained 10-class model (not committed to git):
# Classes: Bang hieu, Cay coi, Cot, Den giao thong, Nguoi, O ga, Thung rac, Xe dap, Xe hoi, Xe may
# YOLO_MODEL=httm_yolo11s_v2.pt
NOMINATIM_CONTACT=
# Assistant provider: "openai" or "gemini". If unset, uses openai when OPENAI_API_KEY is set, else gemini when GEMINI_API_KEY is set.
ASSISTANT_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# Generate these with: python setup_assistant.py
ASSISTANT_SIGNING_SECRET=
ASSISTANT_PAIRING_CODE=
ASSISTANT_DAILY_USD=1.00
ASSISTANT_DEVICE_DAILY_USD=0.50
ASSISTANT_RPM=6
# Only for explicitly enabled local debug, never public HTTP.
ASSISTANT_ALLOW_INSECURE_LAN=0
