# Phone: replace with the laptop's Wi-Fi IPv4. Android emulator: 10.0.2.2.
AI_SERVER_URL=http://192.168.1.100:8000

# auto: use the on-device model when available, otherwise use the server.
DETECTION_MODE=auto

# On-device model: a file name inside assets/models/.
#   httm_yolo11n_ft20.tflite  custom 10-class model (default)
#   yolo11n.tflite            stock COCO model, for comparison
# Rebuild the app after changing it.
DEVICE_MODEL=httm_yolo11n_ft20.tflite
